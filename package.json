{
  "name": "smart-intake-widget",
  "version": "3.0.0",
  "description": "An embeddable smart intake component. Drop a form into any site; incoming messages are classified, tagged and prioritized on submit.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/smart-intake-widget.cjs",
  "module": "./dist/smart-intake-widget.js",
  "exports": {
    ".": {
      "import": "./dist/smart-intake-widget.js",
      "require": "./dist/smart-intake-widget.cjs"
    },
    "./styles.css": "./dist/smart-intake-widget.css"
  },
  "files": [
    "dist",
    "server",
    "README.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "preview": "vite preview",
    "build": "npm run build:demo && npm run build:lib && npm run build:embed && npm run stage:embed",
    "build:demo": "BUILD_TARGET=demo vite build",
    "build:lib": "BUILD_TARGET=lib vite build",
    "build:embed": "BUILD_TARGET=embed vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "proxy": "node server/node-proxy.mjs",
    "build:site": "npm run build:demo && npm run build:embed && npm run stage:embed",
    "stage:embed": "node scripts/stage-embed.mjs"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "keywords": [
    "react",
    "widget",
    "embeddable",
    "intake",
    "classification",
    "triage",
    "support-form",
    "contact-form",
    "shadow-dom"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
