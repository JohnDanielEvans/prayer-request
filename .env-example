# Copy to .env. Never commit the real file.
#
# Only needed if you want the browser to call OpenAI directly, which is a
# LOCAL DEVELOPMENT convenience. A key here is compiled into the JavaScript you
# serve -- anyone can read it out of a deployed site.
#
# The demo runs without any of this: it uses the offline classifier by default.
VITE_OPENAI_API_KEY=

# --- Production path: the server-side proxy in server/ reads these ---
# The key stays in the server process and never reaches a browser.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PORT=8787
# Comma-separated list of sites allowed to call the proxy. Set before deploying.
ALLOWED_ORIGINS=http://localhost:3000
